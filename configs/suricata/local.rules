# Local test rules for the host-only lab network (192.168.56.0/24)
# Kali (attacker): 192.168.56.102 | Windows: .103 | Ubuntu: .105
#
# Include in /etc/suricata/suricata.yaml:
#   default-rule-path: /var/lib/suricata/rules
#   rule-files:
#     - suricata.rules
#     - local.rules

# ICMP echo request (ping) from Kali to the targets
alert icmp 192.168.56.102 any -> [192.168.56.103,192.168.56.105] any (msg:"LOCAL ICMP ping from Kali to victim"; itype:8; sid:1000001; rev:1;)

# TCP SYN (scan or connection attempt) from Kali to the targets
alert tcp 192.168.56.102 any -> [192.168.56.103,192.168.56.105] any (msg:"LOCAL TCP SYN scan from Kali to victim"; flags:S,12; sid:1000002; rev:1;)

# Optional: dampen the alert flood during broad scans (not active in the measurement runs)
# alert tcp 192.168.56.102 any -> [192.168.56.103,192.168.56.105] any (msg:"LOCAL TCP SYN scan (thresholded)"; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; sid:1000003; rev:1;)
