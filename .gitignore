# Raw data stays local; placeholders, screenshots and result tables are versioned
results/raw/*
results/processed/*
results/screenshots/*
!results/raw/.gitkeep
!results/raw/*.png
!results/processed/.gitkeep
!results/screenshots/.gitkeep
